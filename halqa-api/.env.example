# Copy to .env — NEVER commit real values (`.env` is gitignored).
# Provider: OpenAI-compatible. Live mapping (aipilot):
#   PROVIDER_BASE_URL=https://aipilot-weld.vercel.app
#   COMPACT_MODEL=haiku-5.5  LARGER_MODEL=sonnet-5.5
NODE_ENV=development
PORT=3000
# Required. Local compose: mongodb://localhost:27017/halqa
# Without a local Mongo, run the app under the test harness instead:
#   npm run test:int   (uses mongodb-memory-server, no URI needed)
MONGODB_URI=
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
COMPACT_MODEL=
LARGER_MODEL=
QUOTA_C=20
QUOTA_L=5
WINDOW_S=45
CHAOS_ENABLED=false
# Required, no default: the app refuses to boot with this blank.
# Sessions are revoked by bumping the learner's stored epoch, so a leak here
# means rotating this value signs everybody out — that is the intended lever.
TOKEN_SECRET=change-me-to-at-least-32-random-bytes
CORS_ORIGINS=http://localhost:5173
