    "react-router-dom": "^7.18.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.14.1",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.5",
