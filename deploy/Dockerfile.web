# Web image: build the SPA, then serve it from Caddy, which also reverse-proxies
# the API. One container owns the browser-facing origin, so the SPA and /api
# share a host and the client needs no CORS.
#
# VITE_API_BASE is a build arg, not a runtime env var: Vite inlines it into the
# bundle. `vite.config.ts` refuses a production build without it, which is the
# guard that stops a localhost-pointing bundle from shipping.

FROM node:22.19-alpine AS build
WORKDIR /app
COPY halqa-web/package*.json ./
RUN npm ci
COPY halqa-web/ ./
ARG VITE_API_BASE
ENV VITE_API_BASE=${VITE_API_BASE}
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
EXPOSE 80 443
